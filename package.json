{
  "name": "weavecode",
  "productName": "WeaveCode",
  "version": "3.0.0-alpha.0",
  "description": "织码 WeaveCode：基于 CodeOSS、面向嵌入式 ARM 的远程 IDE",
  "private": true,
  "license": "MIT",
  "author": "yon",
  "scripts": {
    "compile": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --force",
    "lint": "eslint . --ext .ts,.mjs",
    "test": "vitest run",
    "build:extension": "node ide/tools/build-extension.mjs",
    "build:deb": "bash ide/tools/build-deb.sh",
    "verify:release": "bash ide/tools/release-check.sh",
    "run": "bash ide/tools/run-app.sh",
    "e2e": "bash ide/tools/run-e2e.sh",
    "codeoss:bootstrap": "git submodule update --init --recursive ide/vscode"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ssh2": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "electron": "^33.2.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "cpu-features": false,
    "ssh2@1.17.0": true
  }
}
