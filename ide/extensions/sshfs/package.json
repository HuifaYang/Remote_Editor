{
  "name": "rce-remote",
  "displayName": "织码 WeaveCode 远程 SSH",
  "description": "织码 WeaveCode 的 SSH/SFTP 远端层：远端文件、终端、搜索、SCM、任务和本机影子语言服务",
  "version": "0.2.0",
  "publisher": "remote-code-editor",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "enabledApiProposals": [
    "fileSearchProvider",
    "textSearchProvider",
    "contribViewsRemote",
    "scmHistoryProvider",
    "scmActionButton",
    "contribSourceControlHistoryItemMenu"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "*",
    "onFileSystem:sshfs"
  ],
  "contributes": {
    "taskDefinitions": [
      {
        "type": "rce-remote",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "任务名（对应远端 tasks.json 里的 label）"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "rce.connect",
        "title": "连接到远程主机…",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.disconnect",
        "title": "断开远程连接",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.newRemoteTerminal",
        "title": "新建远程终端",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.showLog",
        "title": "显示日志",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.scm.refresh",
        "title": "刷新远端仓库",
        "category": "织码 WeaveCode",
        "icon": "$(refresh)"
      },
      {
        "command": "rce.scm.stage",
        "title": "暂存更改",
        "category": "织码 WeaveCode",
        "icon": "$(add)"
      },
      {
        "command": "rce.scm.unstage",
        "title": "取消暂存",
        "category": "织码 WeaveCode",
        "icon": "$(remove)"
      },
      {
        "command": "rce.scm.discard",
        "title": "放弃更改",
        "category": "织码 WeaveCode",
        "icon": "$(discard)"
      },
      {
        "command": "rce.scm.commit",
        "title": "提交",
        "category": "织码 WeaveCode",
        "icon": "$(check)"
      },
      {
        "command": "rce.scm.commitAmend",
        "title": "提交（修改）",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.scm.commitAndPush",
        "title": "提交和推送",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.scm.checkout",
        "title": "切换分支",
        "category": "织码 WeaveCode",
        "icon": "$(git-branch)"
      },
      {
        "command": "rce.scm.checkoutCommit",
        "title": "检出此提交",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.scm.revertCommit",
        "title": "撤销此提交",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.scm.resetCommit",
        "title": "重置到此提交（丢弃之后所有提交）",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.scm.copyCommitId",
        "title": "复制提交 ID",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.scm.stageAll",
        "title": "暂存全部更改",
        "category": "织码 WeaveCode",
        "icon": "$(add)"
      },
      {
        "command": "rce.scm.unstageAll",
        "title": "取消暂存全部更改",
        "category": "织码 WeaveCode",
        "icon": "$(remove)"
      },
      {
        "command": "rce.lsp.menu",
        "title": "语言服务：模式与操作"
      },
      {
        "command": "rce.lsp.browseMode",
        "title": "切换到浏览模式",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.lsp.intelligentMode",
        "title": "切换到代码智能",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.lsp.toggleMode",
        "title": "切换浏览/代码智能模式",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.lsp.configure",
        "title": "配置语言服务器…",
        "category": "织码 WeaveCode"
      },
      {
        "command": "rce.lsp.syncMirror",
        "title": "刷新语言服务（兼容镜像同步）",
        "category": "织码 WeaveCode",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rce.lsp.restart",
        "title": "重启语言服务",
        "category": "织码 WeaveCode",
        "icon": "$(debug-restart)"
      },
      {
        "command": "rce.cache.cleanup",
        "title": "清理本地兼容镜像缓存",
        "category": "织码 WeaveCode",
        "icon": "$(trash)"
      },
      {
        "command": "remote-explorer.add",
        "title": "新建远程",
        "icon": "$(plus)"
      },
      {
        "command": "remote-explorer.configureSsh",
        "title": "打开 SSH 配置文件",
        "icon": "$(gear)"
      },
      {
        "command": "remote-explorer.refresh",
        "title": "刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "remote-explorer.connectToRemoteInCurrentWindow",
        "title": "在当前窗口中连接...",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-explorer.connectToRemoteInNewWindow",
        "title": "在新窗口中连接...",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-explorer.connectToFolderInCurrentWindow",
        "title": "在当前窗口中连接...",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-explorer.connectToFolderInNewWindow",
        "title": "在新窗口中连接...",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-explorer.deleteFolderHistoryItem",
        "title": "从最近使用列表中删除",
        "icon": "$(remove)"
      }
    ],
    "keybindings": [
      {
        "command": "rce.connect",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "rce.newRemoteTerminal",
        "key": "ctrl+shift+alt+`",
        "when": "virtualWorkspace"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "rce.scm.commit",
          "when": "scmProvider =~ /^rce-sshfs/",
          "group": "navigation"
        },
        {
          "command": "rce.scm.checkout",
          "when": "scmProvider =~ /^rce-sshfs/",
          "group": "navigation"
        },
        {
          "command": "rce.scm.refresh",
          "when": "scmProvider =~ /^rce-sshfs/",
          "group": "navigation"
        }
      ],
      "scm/historyItem/context": [
        {
          "command": "rce.scm.checkoutCommit",
          "when": "scmProvider =~ /^rce-sshfs/",
          "group": "1_checkout@1"
        },
        {
          "command": "rce.scm.revertCommit",
          "when": "scmProvider =~ /^rce-sshfs/",
          "group": "3_modify@1"
        },
        {
          "command": "rce.scm.resetCommit",
          "when": "scmProvider =~ /^rce-sshfs/",
          "group": "3_modify@2"
        },
        {
          "command": "rce.scm.copyCommitId",
          "when": "scmProvider =~ /^rce-sshfs/",
          "group": "9_copy@1"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "rce.scm.stageAll",
          "when": "scmProvider =~ /^rce-sshfs/ && scmResourceGroup == changes",
          "group": "inline"
        },
        {
          "command": "rce.scm.unstageAll",
          "when": "scmProvider =~ /^rce-sshfs/ && scmResourceGroup == staged",
          "group": "inline"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "rce.scm.stage",
          "when": "scmProvider =~ /^rce-sshfs/ && scmResourceGroup == changes",
          "group": "inline"
        },
        {
          "command": "rce.scm.unstage",
          "when": "scmProvider =~ /^rce-sshfs/ && scmResourceGroup == staged",
          "group": "inline"
        },
        {
          "command": "rce.scm.discard",
          "when": "scmProvider =~ /^rce-sshfs/ && scmResourceGroup == changes",
          "group": "discard"
        }
      ],
      "commandPalette": [
        {
          "command": "remote-explorer.add",
          "when": "false"
        },
        {
          "command": "remote-explorer.configureSsh",
          "when": "false"
        },
        {
          "command": "remote-explorer.refresh",
          "when": "false"
        },
        {
          "command": "remote-explorer.connectToRemoteInCurrentWindow",
          "when": "false"
        },
        {
          "command": "remote-explorer.connectToRemoteInNewWindow",
          "when": "false"
        },
        {
          "command": "remote-explorer.connectToFolderInCurrentWindow",
          "when": "false"
        },
        {
          "command": "remote-explorer.connectToFolderInNewWindow",
          "when": "false"
        },
        {
          "command": "remote-explorer.deleteFolderHistoryItem",
          "when": "false"
        },
        {
          "command": "rce.disconnect",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "remote-explorer.refresh",
          "when": "view == remoteTargets",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "remote-explorer.configureSsh",
          "when": "viewItem == remote-explorer.sshGroup",
          "group": "inline@1"
        },
        {
          "command": "remote-explorer.configureSsh",
          "when": "viewItem == remote-explorer.sshGroup",
          "group": "navigation@1"
        },
        {
          "command": "remote-explorer.add",
          "when": "viewItem == remote-explorer.sshGroup",
          "group": "inline@2"
        },
        {
          "command": "remote-explorer.add",
          "when": "viewItem == remote-explorer.sshGroup",
          "group": "navigation@2"
        },
        {
          "command": "remote-explorer.connectToRemoteInCurrentWindow",
          "when": "viewItem == remote-explorer.sshRemoteTarget",
          "group": "inline@1"
        },
        {
          "command": "remote-explorer.connectToRemoteInCurrentWindow",
          "when": "viewItem == remote-explorer.sshRemoteTarget",
          "group": "navigation@1"
        },
        {
          "command": "remote-explorer.connectToRemoteInNewWindow",
          "when": "viewItem == remote-explorer.sshRemoteTarget",
          "group": "inline@2"
        },
        {
          "command": "remote-explorer.connectToRemoteInNewWindow",
          "when": "viewItem == remote-explorer.sshRemoteTarget",
          "group": "navigation@2"
        },
        {
          "command": "remote-explorer.connectToFolderInCurrentWindow",
          "when": "viewItem == remote-explorer.remoteFolder",
          "group": "inline@1"
        },
        {
          "command": "remote-explorer.connectToFolderInCurrentWindow",
          "when": "viewItem == remote-explorer.remoteFolder",
          "group": "navigation@1"
        },
        {
          "command": "remote-explorer.connectToFolderInNewWindow",
          "when": "viewItem == remote-explorer.remoteFolder",
          "group": "inline@2"
        },
        {
          "command": "remote-explorer.connectToFolderInNewWindow",
          "when": "viewItem == remote-explorer.remoteFolder",
          "group": "navigation@2"
        },
        {
          "command": "remote-explorer.deleteFolderHistoryItem",
          "when": "viewItem == remote-explorer.remoteFolder",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "织码 WeaveCode",
      "properties": {
        "rce.watch.pollMs": {
          "type": "number",
          "default": 3000,
          "markdownDescription": "远端目录轮询间隔（毫秒）。SFTP 没有 inotify，远端又不允许常驻服务，所以外部改动只能轮询发现；调大可以省带宽。"
        },
        "rce.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "是否启用标准 LSP 语言服务。默认在开发机按需运行，通过只读 SSHFS 惰性读取远端文件；目标机无需安装语言服务，也不会复制源码/sysroot。"
        },
        "rce.lsp.transport": {
          "type": "string",
          "enum": [
            "mount",
            "local",
            "remote",
            "disabled"
          ],
          "enumDescriptions": [
            "开发机运行语言服务，通过只读 SSHFS 惰性读取远端整棵文件系统（推荐）",
            "开发机运行语言服务，使用旧的源码镜像兼容模式",
            "目标机已自行安装语言服务器时，通过 SSH exec 直接运行",
            "完全关闭语言服务"
          ],
          "default": "mount",
          "markdownDescription": "语言服务执行位置。`mount` 默认推荐：目标机只需 sshd/sftp，开发机语言服务通过只读 SSHFS 直接读取远端源码、系统头和 ROS 环境；`remote` 仅在目标机已有对应 LSP 时使用；`local` 是旧镜像兼容模式。"
        },
        "rce.lsp.mode": {
          "type": "string",
          "enum": ["browse", "intelligent"],
          "enumDescriptions": ["只浏览：不启动语言服务，资源占用最低", "代码智能：补全、跳转、诊断、格式化和重构"],
          "default": "browse",
          "markdownDescription": "语言模式。浏览模式保持零语言服务进程；切到代码智能时当前文件优先启动，不重启窗口，标签、光标和撤销历史都保留。"
        },
        "rce.lsp.autoPromoteOnEdit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "浏览模式下第一次编辑时自动切换到代码智能。只想看代码时不会启动任何语言服务。"
        },
        "rce.lsp.warmRetentionMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "从代码智能切回浏览模式后，语言服务热保留多少分钟供快速切回；0 = 立即停止。RK3566/2GB 建议 2–5 分钟。"
        },
        "rce.lsp.servers": {
          "type": "object",
          "default": {},
          "markdownDescription": "任意标准 LSP 的启动描述，键是服务器 ID。示例：`{\"go\":{\"command\":\"gopls\",\"args\":[],\"extensions\":[\".go\"],\"rootMarkers\":[\"go.mod\"]}}`。C++/Python 已内置，可用 `false` 关闭默认项。",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "boolean" },
              {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean" },
                  "command": { "type": "string" },
                  "args": { "type": "array", "items": { "type": "string" } },
                  "languageIds": { "type": "array", "items": { "type": "string" } },
                  "extensions": { "type": "array", "items": { "type": "string" } },
                  "rootMarkers": { "type": "array", "items": { "type": "string" } },
                  "env": { "type": "object", "additionalProperties": { "type": "string" } },
                  "initializationOptions": {}
                }
              }
            ]
          }
        },
        "rce.lsp.cppPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "开发机 clangd 命令或绝对路径（留空 = IDE 内置 clangd）。仅 remote 兼容模式会在目标机执行。"
        },
        "rce.lsp.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "开发机 Python 语言服务命令（留空 = 内置 python-lsp-server）。仅 remote 兼容模式会在目标机执行。"
        },
        "rce.lsp.sshfsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "开发机 sshfs 可执行文件路径（留空 = PATH 中的 `sshfs`）。mount 模式需要该工具；deb 会自动安装依赖。"
        },
        "remote.SSH.configFile": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "自定义 SSH 配置文件路径。留空时使用 ~/.ssh/config。"
        },
        "remote-explorer.foldersSortOrder": {
          "type": "string",
          "description": "指定在远程资源管理器的远程目标下显示文件夹的顺序。",
          "default": "most recently used",
          "scope": "application",
          "enum": [
            "most recently used",
            "alphabetical"
          ],
          "enumDescriptions": [
            "按最近在顶部打开的顺序显示文件夹",
            "按字母顺序显示文件夹"
          ]
        },
        "remote-explorer.collapseRecentFolders": {
          "type": "boolean",
          "default": false,
          "description": "折叠远程资源管理器远程目标下的最近文件夹。",
          "scope": "application"
        },
        "rce.lsp.maxFiles": {
          "type": "number",
          "default": 20000,
          "markdownDescription": "仅 local 兼容模式的镜像文件上限；remote 模式直接读取远端源码，不受此项影响。"
        },
        "rce.cache.maxSizeMB": {
          "type": "number",
          "default": 10240,
          "markdownDescription": "仅 local 兼容模式的影子缓存总容量上限（MB）；remote 模式不建立源码镜像。"
        },
        "rce.cache.maxProjectMB": {
          "type": "number",
          "default": 5120,
          "markdownDescription": "仅 local 兼容模式的单项目影子缓存上限（MB）。"
        },
        "rce.cache.ttlDays": {
          "type": "number",
          "default": 30,
          "markdownDescription": "仅 local 兼容模式的影子缓存 TTL（天）。设为 0 表示不按时间清理。"
        },
        "rce.cache.cleanupOnDisconnect": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "断开远程连接后立即执行一次缓存容量/过期清理。不会删除当前仍在使用或未同步的项目。"
        }
      }
    },
    "configurationDefaults": {
      "terminal.integrated.defaultProfile.linux": "织码 WeaveCode",
      "terminal.integrated.defaultProfile.osx": "织码 WeaveCode",
      "window.confirmSaveUntitledWorkspace": false
    },
    "terminal": {
      "profiles": [
        {
          "id": "rceRemote",
          "title": "织码 WeaveCode",
          "icon": "remote"
        }
      ]
    },
    "views": {
      "remote": [
        {
          "id": "remoteTargets",
          "name": "远程(隧道/SSH)",
          "group": "targets@1",
          "remoteName": "sshfs"
        }
      ]
    }
  }
}
